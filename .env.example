# Local defaults. Do not add credentials or secrets to this file.
STAGE=dev
AWS_REGION=us-east-1

# Local MySQL running through Docker Compose.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=prana
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-local-root
MYSQL_DATABASE_PE=prana_pe
MYSQL_DATABASE_CL=prana_cl
